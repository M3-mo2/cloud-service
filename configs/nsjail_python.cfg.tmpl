# nsjail configuration template rendered per run by sandboxd.
# Rendered by internal/executor/nsjail.go. Do not edit in place; edit the Go
# template data if you need different fields.
#
# This is nsjail TextProto format. Field names below are verified against the
# installed nsjail build; invalid fields cause a hard parse failure.

name: "sandboxd-run"
mode: ONCE

hostname: "sandbox"

# Namespaces. Network is isolated unless the workspace opts in (allow_net).
clone_newnet: {{ if .AllowNet }}false{{ else }}true{{ end }}
clone_newuser: true
clone_newns: true
clone_newpid: true
clone_newipc: true
clone_newuts: true

# Use cgroup v2 (unified hierarchy). Required on modern hosts.
use_cgroupv2: true

# Do not mount /proc: it leaks host process information.
mount_proc: false

# Mount the Python runtime and system libraries read-only, then the workspace
# writable at /workspace.
mount {
  src: "/usr"
  dst: "/usr"
  is_bind: true
  rw: false
}

mount {
  src: "/lib"
  dst: "/lib"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/lib64"
  dst: "/lib64"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/bin"
  dst: "/bin"
  is_bind: true
  rw: false
}

mount {
  src: "/sbin"
  dst: "/sbin"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/etc/alternatives"
  dst: "/etc/alternatives"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/etc/ssl/certs"
  dst: "/etc/ssl/certs"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/etc/ld.so.cache"
  dst: "/etc/ld.so.cache"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/etc/nsswitch.conf"
  dst: "/etc/nsswitch.conf"
  is_bind: true
  rw: false
  mandatory: false
}

{{- if .AllowNet }}

# DNS configuration. Without a resolv.conf inside the jail, name resolution
# fails with "Temporary failure in name resolution" even though the network
# namespace is shared with the host: the resolver has no nameserver to query.
# This is what breaks `pip install` (and any workload that resolves a hostname)
# for a workspace with allow_net enabled. mandatory:false so a host without
# /etc/resolv.conf still renders a valid run.
mount {
  src: "/etc/resolv.conf"
  dst: "/etc/resolv.conf"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/etc/hosts"
  dst: "/etc/hosts"
  is_bind: true
  rw: false
  mandatory: false
}
{{- end }}

mount {
  src: "/etc/passwd"
  dst: "/etc/passwd"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/etc/group"
  dst: "/etc/group"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/dev/urandom"
  dst: "/dev/urandom"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/dev/null"
  dst: "/dev/null"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/dev/zero"
  dst: "/dev/zero"
  is_bind: true
  rw: false
  mandatory: false
}

{{- if .PTY }}

# Terminal sessions only: the relay helper allocates the PTY with pty.fork(),
# which needs a usable /dev/ptmx and devpts. nsjail has no PTY support of its
# own, and a private devpts instance is not enough: CPython's openpty() opens
# /dev/ptmx, which a `newinstance` devpts does not provide (measured: openpty
# then fails with ENOENT). Binding the HOST's /dev/pts and /dev/ptmx is the
# measured minimum that makes pty.fork() succeed inside the jail. Both are
# read-only binds of device nodes -- a terminal is not a filesystem or process
# view -- and uid/gid, seccomp, mount and namespace isolation are unchanged.
# Omitted for one-shot exec, which needs no terminal.
mount {
  src: "/dev/pts"
  dst: "/dev/pts"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/dev/ptmx"
  dst: "/dev/ptmx"
  is_bind: true
  rw: false
  mandatory: false
}
{{- end }}

# The workspace, writable, at /workspace.
mount {
  src: "{{ .WorkspaceRoot }}"
  dst: "/workspace"
  is_bind: true
  rw: true
}

# A private, per-run writable /tmp. Never the host's /tmp.
mount {
  src: "{{ .TempDir }}"
  dst: "/tmp"
  is_bind: true
  rw: true
}

{{- if .HelperDir }}

# The terminal-session PTY relay helper, mounted read-only so the interactive
# shell cannot rewrite the code that allocates its terminal. It runs as the
# sandbox uid with the same mounts and seccomp policy as any workload.
mount {
  src: "{{ .HelperDir }}"
  dst: "/run/sandboxd"
  is_bind: true
  rw: false
}
{{- end }}

{{- if .SharedPackagesDir }}

# Shared package tier: ONE package set on the host, visible read-only to every
# workspace. rw:false is the security core: no workspace can modify or poison
# it for the others. Omitted entirely when the tier is not mounted.
# mandatory:false so a directory that disappears after the config is rendered
# cannot abort an otherwise valid run.
mount {
  src: "{{ .SharedPackagesDir }}"
  dst: "/opt/python/shared"
  is_bind: true
  rw: false
  mandatory: false
}
{{- end }}

{{- if .PrivatePackagesDir }}

# Private package tier: per-workspace, writable, isolated from every other
# workspace. The host directory is chowned to the sandbox uid by the runner,
# so only this workspace's workload can write it.
mount {
  src: "{{ .PrivatePackagesDir }}"
  dst: "/opt/python/private"
  is_bind: true
  rw: true
}
{{- end }}

cwd: "{{ .Cwd }}"

# Run as the sandbox user inside the namespace.
#
# The kernel only allows an unprivileged process to write a single-entry
# UID/GID map whose outside id equals its own effective id. sandboxd therefore
# maps the sandbox identity *inside* the namespace onto outside ids that are
# permitted in the current context (see internal/executor/identity.go):
#   - privileged orchestrator: inside sandbox <-> outside sandbox (real drop)
#   - unprivileged orchestrator: inside sandbox <-> outside orchestrator
uidmap {
  inside_id: "{{ .SandboxUID }}"
  outside_id: "{{ .OutsideUID }}"
  count: 1
}
gidmap {
  inside_id: "{{ .SandboxGID }}"
  outside_id: "{{ .OutsideGID }}"
  count: 1
}

# Resource limits.
# nsjail interprets rlimit_as and rlimit_fsize in MEGABYTES (verified against
# the installed build's --help), so the values below are MB, not bytes.
time_limit: {{ .TimeLimitSec }}
rlimit_as: {{ .AsMB }}
rlimit_fsize: {{ .FsizeMB }}
rlimit_nofile: 256
rlimit_nproc: {{ .PidsMax }}
rlimit_core: 0

# cgroup v2 limits (memory in bytes, cpu in microseconds per second).
cgroup_mem_max: {{ .MemoryBytes }}
cgroup_pids_max: {{ .PidsMax }}
cgroup_cpu_ms_per_sec: {{ .CPUMilli }}

# Baseline seccomp deny list, applied with a default-allow policy so normal
# program execution is unaffected while dangerous syscalls are killed.
seccomp_string: {{ .SeccompString }}

# Environment: a minimal, non-sensitive base plus user-provided variables.
envar: "PATH=/usr/local/bin:/usr/bin:/bin"
envar: "HOME=/tmp"
envar: "LANG=C.UTF-8"
envar: "PYTHONUNBUFFERED=1"
{{- range .Env }}
envar: {{ printf "%q" . }}
{{- end }}

exec_bin {
  path: "{{ index .Argv 0 }}"
{{- range $i, $a := .Argv }}
{{- if ne $i 0 }}
  arg: {{ printf "%q" $a }}
{{- end }}
{{- end }}
}
