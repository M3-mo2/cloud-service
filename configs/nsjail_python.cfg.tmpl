# nsjail configuration template rendered per run by sandboxd.
# Rendered by internal/executor/nsjail.go. Do not edit in place; edit the Go
# template data if you need different fields.
#
# This is nsjail TextProto format. Field names below are verified against the
# installed nsjail build; invalid fields cause a hard parse failure.

name: "sandboxd-run"
mode: ONCE

hostname: "sandbox"

# Namespaces. Network is isolated unless the workspace opts in (allow_net).
clone_newnet: {{ if .AllowNet }}false{{ else }}true{{ end }}
clone_newuser: true
clone_newns: true
clone_newpid: true
clone_newipc: true
clone_newuts: true

# Use cgroup v2 (unified hierarchy). Required on modern hosts.
use_cgroupv2: true

# Do not mount /proc: it leaks host process information.
mount_proc: false

# Mount the Python runtime and system libraries read-only, then the workspace
# writable at /workspace.
mount {
  src: "/usr"
  dst: "/usr"
  is_bind: true
  rw: false
}

mount {
  src: "/lib"
  dst: "/lib"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/lib64"
  dst: "/lib64"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/bin"
  dst: "/bin"
  is_bind: true
  rw: false
}

mount {
  src: "/sbin"
  dst: "/sbin"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/etc/alternatives"
  dst: "/etc/alternatives"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/etc/ssl/certs"
  dst: "/etc/ssl/certs"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/etc/ld.so.cache"
  dst: "/etc/ld.so.cache"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/etc/nsswitch.conf"
  dst: "/etc/nsswitch.conf"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/etc/passwd"
  dst: "/etc/passwd"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/etc/group"
  dst: "/etc/group"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/dev/urandom"
  dst: "/dev/urandom"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/dev/null"
  dst: "/dev/null"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/dev/zero"
  dst: "/dev/zero"
  is_bind: true
  rw: false
  mandatory: false
}

# The workspace, writable, at /workspace.
mount {
  src: "{{ .WorkspaceRoot }}"
  dst: "/workspace"
  is_bind: true
  rw: true
}

# A private, per-run writable /tmp. Never the host's /tmp.
mount {
  src: "{{ .TempDir }}"
  dst: "/tmp"
  is_bind: true
  rw: true
}

cwd: "{{ .Cwd }}"

# Run as the sandbox user inside the namespace.
#
# The kernel only allows an unprivileged process to write a single-entry
# UID/GID map whose outside id equals its own effective id. sandboxd therefore
# maps the sandbox identity *inside* the namespace onto outside ids that are
# permitted in the current context (see internal/executor/identity.go):
#   - privileged orchestrator: inside sandbox <-> outside sandbox (real drop)
#   - unprivileged orchestrator: inside sandbox <-> outside orchestrator
uidmap {
  inside_id: "{{ .SandboxUID }}"
  outside_id: "{{ .OutsideUID }}"
  count: 1
}
gidmap {
  inside_id: "{{ .SandboxGID }}"
  outside_id: "{{ .OutsideGID }}"
  count: 1
}

# Resource limits.
# nsjail interprets rlimit_as and rlimit_fsize in MEGABYTES (verified against
# the installed build's --help), so the values below are MB, not bytes.
time_limit: {{ .TimeLimitSec }}
rlimit_as: {{ .AsMB }}
rlimit_fsize: {{ .FsizeMB }}
rlimit_nofile: 256
rlimit_nproc: {{ .PidsMax }}
rlimit_core: 0

# cgroup v2 limits (memory in bytes, cpu in microseconds per second).
cgroup_mem_max: {{ .MemoryBytes }}
cgroup_pids_max: {{ .PidsMax }}
cgroup_cpu_ms_per_sec: {{ .CPUMilli }}

# Baseline seccomp deny list, applied with a default-allow policy so normal
# program execution is unaffected while dangerous syscalls are killed.
seccomp_string: {{ .SeccompString }}

# Environment: a minimal, non-sensitive base plus user-provided variables.
envar: "PATH=/usr/local/bin:/usr/bin:/bin"
envar: "HOME=/tmp"
envar: "LANG=C.UTF-8"
envar: "PYTHONUNBUFFERED=1"
{{- range .Env }}
envar: {{ printf "%q" . }}
{{- end }}

exec_bin {
  path: "{{ index .Argv 0 }}"
{{- range $i, $a := .Argv }}
{{- if ne $i 0 }}
  arg: {{ printf "%q" $a }}
{{- end }}
{{- end }}
}
