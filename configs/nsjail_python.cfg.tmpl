# nsjail configuration template rendered per run by sandboxd.
# Rendered by internal/executor/nsjail.go. Do not edit in place; edit the Go
# template data if you need different fields.
#
# This is nsjail TextProto format. Field names below are verified against the
# installed nsjail build; invalid fields cause a hard parse failure.

name: "sandboxd-run"
mode: ONCE

hostname: "sandbox"

# Namespaces. The network namespace is NEVER shared with the host. When the
# workspace has an engine-managed private namespace, the runner asks nsjail to
# stay in it (clone_newnet set false means "do not create another one"; nsjail
# is already inside the workspace's own namespace, entered via nsenter). With no
# managed namespace the runner makes nsjail create a fresh, empty one. No
# configuration shares the host network namespace.
clone_newnet: {{ if .JoinNetns }}false{{ else }}true{{ end }}
clone_newuser: true
clone_newns: true
clone_newpid: true
clone_newipc: true
clone_newuts: true

# Use cgroup v2 (unified hierarchy). Required on modern hosts.
use_cgroupv2: true

# The workspace's PARENT cgroup. Every run's leaf cgroup is created INSIDE it,
# and the parent's memory.max is the workspace's ENFORCED ceiling -- so the SUM
# across concurrent runs is bounded by the advertised memory_mb, not N x
# memory_mb. Moving an existing cgroup under a parent is EPERM, so nsjail must
# be pointed here at launch. Empty (a host without engine-managed cgroups, or a
# legacy record) omits the field and nsjail uses its default root layout.
{{- if .Cgroupv2Mount }}
cgroupv2_mount: "{{ .Cgroupv2Mount }}"
{{- end }}

# Do not mount /proc: it leaks host process information.
mount_proc: false

# The toolchain. With a workspace profile (the default) the ENTIRE /usr is a
# profile-materialized tree that contains ONLY the commands the profile names
# (an explicit allowlist) plus the engine base, the shared libraries and the
# loaders. Un-allowlisted host material (/usr/include, /usr/libexec,
# /usr/share/perl, apt, the gcc chain, the platform's /usr/local tooling) simply
# does not exist inside the workspace, so it cannot leak through an un-overlaid
# directory. /bin, /sbin, /lib and /lib64 are bound to subtrees of the same
# curated tree, so a tenant sees one consistent allowlisted toolchain at every
# conventional path. mandatory:true is the fail-loud contract: if the curated
# tree cannot be mounted the run aborts rather than expose the host /usr.
#
# With provider-tool hiding OFF (a diagnostic state) the host /usr is mounted
# unchanged.
mount {
  src: "{{ if .OverlayEnabled }}{{ .UsrRoot }}{{ else }}/usr{{ end }}"
  dst: "{{ .UsrJail }}"
  is_bind: true
  rw: false
  {{- if .OverlayEnabled }} mandatory: true {{- end }}
}

{{- if .OverlayEnabled }}

mount {
  src: "{{ .UsrRoot }}/bin"
  dst: "{{ .BinJail }}"
  is_bind: true
  rw: false
  mandatory: true
}

mount {
  src: "{{ .UsrRoot }}/sbin"
  dst: "{{ .SbinJail }}"
  is_bind: true
  rw: false
  mandatory: true
}

mount {
  src: "{{ .UsrRoot }}/lib"
  dst: "{{ .LibJail }}"
  is_bind: true
  rw: false
  mandatory: true
}

mount {
  src: "{{ .UsrRoot }}/lib64"
  dst: "{{ .Lib64Jail }}"
  is_bind: true
  rw: false
  mandatory: true
}

# Profile-attached non-/usr paths (e.g. /etc/ssh/ssh_config, an openssl config).
# Each is a tiny read-only mandatory bind; mandatory:true is fail-loud because a
# missing one would leave the tool half-working.
{{- range .ExtraMounts }}
mount {
  src: "{{ .Host }}"
  dst: "{{ .Jail }}"
  is_bind: true
  rw: false
  mandatory: true
}
{{- end }}

# The curated /etc/ssl/certs trust store, filtered of provider certificates.
# Omitted when the host trust store could not be read; the workspace then has no
# /etc/ssl/certs at all (a closed outcome).
{{- if .CertsDir }}
mount {
  src: "{{ .CertsDir }}"
  dst: "/etc/ssl/certs"
  is_bind: true
  rw: false
  mandatory: true
}
{{- end }}
{{- else }}

# Provider-tool hiding OFF: mount the host libraries and toolchain unchanged.
mount {
  src: "/lib"
  dst: "/lib"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/lib64"
  dst: "/lib64"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/bin"
  dst: "/bin"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/sbin"
  dst: "/sbin"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/etc/ssl/certs"
  dst: "/etc/ssl/certs"
  is_bind: true
  rw: false
  mandatory: false
}
{{- end }}

mount {
  src: "/etc/alternatives"
  dst: "/etc/alternatives"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/etc/ld.so.cache"
  dst: "/etc/ld.so.cache"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/etc/nsswitch.conf"
  dst: "/etc/nsswitch.conf"
  is_bind: true
  rw: false
  mandatory: false
}

{{- if .AllowNet }}

# Egress configuration. The workspace is in its OWN network namespace, connected
# to the public internet ONLY through chained slirp4netns instances (a UNIX
# socket, never a host interface or route). The host's /etc/resolv.conf is
# useless there and deliberately NOT mounted (ADR 42/: leaking the host search
# domain and nameservers into an isolated workload is exactly what isolation
# avoids). Instead a per-run resolv.conf naming PUBLIC resolvers is mounted; the
# workspace reaches them through the chained egress, and the relay blackholes
# every operator-private range so the host LAN stays unreachable.
{{- if .ResolverConf }}
mount {
  src: "{{ .ResolverConf }}"
  dst: "/etc/resolv.conf"
  is_bind: true
  rw: false
  mandatory: false
}
{{- end }}

# A generic, per-workspace /etc/hosts. The HOST's own /etc/hosts is deliberately
# NOT mounted: it names the operator's server FQDN (e.g. node-id-1.runtime.zcp.
# zerops) and its LAN address, which identify the machine and its internal DNS.
# The generated file resolves only localhost.
{{- if .HostsConf }}
mount {
  src: "{{ .HostsConf }}"
  dst: "/etc/hosts"
  is_bind: true
  rw: false
  mandatory: false
}
{{- end }}
{{- end }}

mount {
  src: "{{ if .OverlayEnabled }}{{ .PasswdHost }}{{ else }}/etc/passwd{{ end }}"
  dst: "/etc/passwd"
  is_bind: true
  rw: false
  {{- if .OverlayEnabled }} mandatory: true {{- end }}
}

mount {
  src: "{{ if .OverlayEnabled }}{{ .GroupHost }}{{ else }}/etc/group{{ end }}"
  dst: "/etc/group"
  is_bind: true
  rw: false
  {{- if .OverlayEnabled }} mandatory: true {{- end }}
}

mount {
  src: "/dev/urandom"
  dst: "/dev/urandom"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/dev/null"
  dst: "/dev/null"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/dev/zero"
  dst: "/dev/zero"
  is_bind: true
  rw: false
  mandatory: false
}

{{- if .ProcEnabled }}

# Synthetic per-workspace /proc. mount_proc stays false: the real procfs leaks
# host process, network and kernel-identity information. This is a CURATED,
# per-workspace directory carrying ONLY the workspace's own resource facts --
# meminfo (MemTotal = the workspace's memory ceiling, SwapTotal 0), cpuinfo and
# stat (exactly cpu_cores cpus), uptime, loadavg, a matching version string and
# a neutral mounts table so `free -h`, `uptime`, `vmstat` and a bare `df` report
# the workspace, never the host. It is read-only (the workspace cannot rewrite
# its own apparent limits) and its source lives under the per-run tmp dir, which
# is removed with the run. mandatory:true is fail-loud: if it cannot be mounted
# the run aborts rather than expose the (empty, but also host-shaped) fallback.
mount {
  src: "{{ .ProcRoot }}"
  dst: "{{ .ProcJail }}"
  is_bind: true
  rw: false
  mandatory: true
}
{{- if .ProcMtab }}

# The conventional /etc/mtab view of the same curated mount list (normally a
# symlink to /proc/self/mounts). Earlier this was omitted on the assumption
# that the curated tree's own /proc/mounts was enough; a workspace should see
# the same table at the conventional path. It is a plain read-only one-file
# bind. mandatory:false: /etc/mtab is not load-bearing for coreutils `df`
# (which reads /proc/self/mountinfo), so a failure here must not abort a run.
mount {
  src: "{{ .ProcMtab }}"
  dst: "/etc/mtab"
  is_bind: true
  rw: false
  mandatory: false
}
{{- end }}
{{- end }}

{{- if .MaskEnabled }}

# Build-identity masking. The shim intercepts the syscall-reachable
# facts a mount namespace cannot hide -- uname, sysinfo, sysconf,
# sched_getaffinity, getauxval, the libc version strings -- and answers with the
# WORKSPACE's own limits. It is reached through a read-only /etc/ld.so.preload,
# which the dynamic loader reads for EVERY dynamically-linked exec, so a tenant
# cannot disable it with `env -i`/`env -u LD_PRELOAD`. Both files are bind
# mounts with rw:false: a workspace can neither replace the shim nor edit the
# preload list. The shim is mounted under /sandboxd (a private root path, not
# under the read-only /usr bind) so nsjail can create the mount point.
#
# mandatory:true is the fail-loud contract: if either mount cannot be applied
# nsjail aborts the run (reported as 503 sandbox_unavailable) rather than start
# a sandbox that would leak. A missing mask is never silent.
mount {
  src: "{{ .MaskShimHost }}"
  dst: "{{ .MaskShimJail }}"
  is_bind: true
  rw: false
  mandatory: true
}

mount {
  src: "{{ .MaskPreloadHost }}"
  dst: "{{ .MaskPreloadJail }}"
  is_bind: true
  rw: false
  mandatory: true
}
{{- end }}

{{- if .PTY }}

# Terminal sessions only: the relay helper allocates the PTY with pty.fork(),
# which needs a usable /dev/ptmx and devpts. nsjail has no PTY support of its
# own, and a private devpts instance is not enough: CPython's openpty() opens
# /dev/ptmx, which a `newinstance` devpts does not provide (measured: openpty
# then fails with ENOENT). Binding the HOST's /dev/pts and /dev/ptmx is the
# measured minimum that makes pty.fork() succeed inside the jail. Both are
# read-only binds of device nodes -- a terminal is not a filesystem or process
# view -- and uid/gid, seccomp, mount and namespace isolation are unchanged.
# Omitted for one-shot exec, which needs no terminal.
mount {
  src: "/dev/pts"
  dst: "/dev/pts"
  is_bind: true
  rw: false
  mandatory: false
}

mount {
  src: "/dev/ptmx"
  dst: "/dev/ptmx"
  is_bind: true
  rw: false
  mandatory: false
}
{{- end }}

# The workspace, writable, at /workspace.
mount {
  src: "{{ .WorkspaceRoot }}"
  dst: "/workspace"
  is_bind: true
  rw: true
}

# A private, per-run writable /tmp. Never the host's /tmp.
mount {
  src: "{{ .TempDir }}"
  dst: "/tmp"
  is_bind: true
  rw: true
}

{{- if .SharedPackagesDir }}

# Shared package tier: ONE package set on the host, visible read-only to every
# workspace. rw:false is the security core: no workspace can modify or poison
# it for the others. Omitted entirely when the tier is not mounted.
# mandatory:false so a directory that disappears after the config is rendered
# cannot abort an otherwise valid run.
mount {
  src: "{{ .SharedPackagesDir }}"
  dst: "/opt/python/shared"
  is_bind: true
  rw: false
  mandatory: false
}
{{- end }}

{{- if .PrivatePackagesDir }}

# Private package tier: per-workspace, writable, isolated from every other
# workspace. The host directory is chowned to the sandbox uid by the runner,
# so only this workspace's workload can write it.
mount {
  src: "{{ .PrivatePackagesDir }}"
  dst: "/opt/python/private"
  is_bind: true
  rw: true
}
{{- end }}

cwd: "{{ .Cwd }}"

# Run as the sandbox user inside the namespace.
#
# The kernel only allows an unprivileged process to write a single-entry
# UID/GID map whose outside id equals its own effective id. sandboxd therefore
# maps the sandbox identity *inside* the namespace onto outside ids that are
# permitted in the current context (see internal/executor/identity.go):
#   - privileged orchestrator: inside sandbox <-> outside sandbox (real drop)
#   - unprivileged orchestrator: inside sandbox <-> outside orchestrator
uidmap {
  inside_id: "{{ .SandboxUID }}"
  outside_id: "{{ .OutsideUID }}"
  count: 1
}
gidmap {
  inside_id: "{{ .SandboxGID }}"
  outside_id: "{{ .OutsideGID }}"
  count: 1
}

# Resource limits.
# nsjail interprets rlimit_as and rlimit_fsize in MEGABYTES (verified against
# the installed build's --help), so the values below are MB, not bytes.
time_limit: {{ .TimeLimitSec }}
rlimit_as: {{ .AsMB }}
rlimit_fsize: {{ .FsizeMB }}
rlimit_nofile: 256
rlimit_nproc: {{ .PidsMax }}
rlimit_core: 0

# Per-run cgroup v2 limits (memory in bytes, cpu in microseconds per second).
# These are the workspace's values, NOT a second, larger budget: the leaf cgroup
# is created INSIDE the workspace's parent (cgroupv2_mount above), whose
# memory.max/pids.max/cpu.max enforce the SUM across every concurrent run. A leaf
# limit is set (rather than 0/unlimited) because nsjail only creates the leaf
# when at least one cgroup limit is set; with all three 0 it creates NO leaf,
# which would cost the engine its cgroup-scoped kill/inventory handle (measured).
cgroup_mem_max: {{ .MemoryBytes }}
cgroup_pids_max: {{ .PidsMax }}
cgroup_cpu_ms_per_sec: {{ .CPUMilli }}

# Baseline seccomp deny list, applied with a default-allow policy so normal
# program execution is unaffected while dangerous syscalls are killed.
seccomp_string: {{ .SeccompString }}

# Environment: a minimal, non-sensitive base plus user-provided variables.
envar: "PATH=/usr/local/bin:/usr/bin:/bin"
envar: "HOME=/tmp"
envar: "LANG=C.UTF-8"
envar: "PYTHONUNBUFFERED=1"
{{- range .TagEnv }}
envar: {{ printf "%q" . }}
{{- end }}
{{- range .MaskEnv }}
envar: {{ printf "%q" . }}
{{- end }}
{{- range .Env }}
envar: {{ printf "%q" . }}
{{- end }}

exec_bin {
  path: "{{ index .Argv 0 }}"
{{- range $i, $a := .Argv }}
{{- if ne $i 0 }}
  arg: {{ printf "%q" $a }}
{{- end }}
{{- end }}
}
